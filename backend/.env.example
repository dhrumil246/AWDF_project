# macOS: port 5000 is taken by AirPlay Receiver, so use 5001 locally.
PORT=5001

# MongoDB Atlas: Database > Connect > Drivers. Replace <user>, <password> and <cluster>.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cardb?retryWrites=true&w=majority

# Frontend origin(s) allowed by CORS, comma-separated.
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Set to true to turn off the in-memory cache (used to measure uncached response times).
DISABLE_CACHE=false

# Artificial delay in the background notification listener (ms), to make async processing visible.
NOTIFY_DELAY_MS=2000

# Gemini API key for AI-generated car descriptions (https://aistudio.google.com/apikey).
# Server-side only — never put it in the frontend. Without it the app still works
# and the AI button reports that suggestions are unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=10000
AI_RATE_LIMIT_MS=10000

# HTTPS (Assignment 2). Create a trusted local certificate with mkcert:
#   brew install mkcert && mkcert -install
#   mkdir -p certs && mkcert -key-file certs/localhost-key.pem -cert-file certs/localhost.pem localhost 127.0.0.1
# then uncomment (and use https://localhost:5001 as VITE_API_URL):
# HTTPS_KEY_FILE=certs/localhost-key.pem
# HTTPS_CERT_FILE=certs/localhost.pem
