{
  "info": {
    "name": "Car Details API",
    "description": "Run 'Create car' first: it stores the new id in {{carId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "carId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "Get all cars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "200"
          }
        },
        {
          "name": "Create car",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "201 + Location header; saves id to {{carId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\",\n  \"model\": \"Seltos\",\n  \"year\": 2024,\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Automatic\",\n  \"price\": 1350000,\n  \"registrationNumber\": \"GJ 01 KZ 4321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('carId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get car by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            },
            "description": "200"
          }
        },
        {
          "name": "Update car",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            },
            "description": "200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1299000,\n  \"status\": \"sold\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete car",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            },
            "description": "200"
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Car not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/aaaaaaaaaaaaaaaaaaaaaaaa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "aaaaaaaaaaaaaaaaaaaaaaaa"
              ]
            },
            "description": "404"
          }
        },
        {
          "name": "Invalid id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "123"
              ]
            },
            "description": "400 (validateId)"
          }
        },
        {
          "name": "Missing required fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400 with per-field details",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Invalid values",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400: min year, negative price, enum",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\",\n  \"model\": \"Sonet\",\n  \"year\": 1900,\n  \"price\": -5,\n  \"fuelType\": \"Steam\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Wrong type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400: year must be a number",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\",\n  \"model\": \"Carens\",\n  \"year\": \"abc\",\n  \"price\": 1100000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Duplicate registration number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "409 (GJ01AB1234 exists in seed data)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\",\n  \"model\": \"Carens\",\n  \"year\": 2024,\n  \"price\": 1100000,\n  \"registrationNumber\": \"GJ01AB1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Wrong Content-Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "415 (requireJson)",
            "body": {
              "mode": "raw",
              "raw": "make=Kia",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400 (error handler)",
            "body": {
              "mode": "raw",
              "raw": "{bad json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "unknown"
              ]
            },
            "description": "404 (notFound)"
          }
        },
        {
          "name": "Deliberate server error",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/error",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "error"
              ]
            },
            "description": "500 (global error handler)"
          }
        }
      ]
    }
  ]
}
