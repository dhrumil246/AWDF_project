{
  "info": {
    "name": "Car Details API",
    "description": "Run 'Auth > Login (demo)' first: it stores the JWT in {{token}}, which every other request sends as Bearer auth. 'Create car' stores the new id in {{carId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "carId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "201 + token; 409 if the email exists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Shah\",\n  \"email\": \"ravi@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (demo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "200 + token (demo user from npm run seed)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@cars.test\",\n  \"password\": \"demo12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "200 current user"
          }
        },
        {
          "name": "Login wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "401",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@cars.test\",\n  \"password\": \"wrongpass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register invalid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "400 with details",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Cars",
      "item": [
        {
          "name": "Get all cars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "200"
          }
        },
        {
          "name": "Create car",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "201 + Location header; saves id to {{carId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\",\n  \"model\": \"Seltos\",\n  \"year\": 2024,\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Automatic\",\n  \"price\": 1350000,\n  \"registrationNumber\": \"GJ 01 KZ 4321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('carId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get car by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            },
            "description": "200"
          }
        },
        {
          "name": "Update car",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            },
            "description": "200 (owner only, else 403)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1299000,\n  \"status\": \"sold\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete car",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            },
            "description": "200 (owner only, else 403)"
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "No token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "401 Authentication required",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Invalid token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not.a.token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "401 Invalid token",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Car not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/aaaaaaaaaaaaaaaaaaaaaaaa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "aaaaaaaaaaaaaaaaaaaaaaaa"
              ]
            },
            "description": "404"
          }
        },
        {
          "name": "Invalid id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "123"
              ]
            },
            "description": "400 (validateId)"
          }
        },
        {
          "name": "Missing required fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400 from validation middleware",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Invalid values",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400: blank make, year not a number, negative price, bad status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"  \",\n  \"model\": \"Sonet\",\n  \"year\": \"2024\",\n  \"price\": -1,\n  \"status\": \"stolen\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Empty update",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            },
            "description": "400: provide at least one field",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Duplicate registration number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "409 (GJ01AB1234 exists in seed data)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\",\n  \"model\": \"Carens\",\n  \"year\": 2024,\n  \"price\": 1100000,\n  \"registrationNumber\": \"GJ01AB1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Wrong Content-Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "415 (requireJson)",
            "body": {
              "mode": "raw",
              "raw": "make=Kia",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400 (error handler)",
            "body": {
              "mode": "raw",
              "raw": "{bad json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "unknown"
              ]
            },
            "description": "404 (notFound)"
          }
        },
        {
          "name": "Deliberate server error",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/error",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "error"
              ]
            },
            "description": "500 (global error handler)"
          }
        }
      ]
    }
  ]
}
