{
  "info": {
    "name": "Car Details API \u2014 Week 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    }
  ],
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "Get all cars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "200"
          }
        },
        {
          "name": "Get car by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "2"
              ]
            },
            "description": "200"
          }
        },
        {
          "name": "Create car",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "201 + Location header",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\",\n  \"model\": \"Seltos\",\n  \"year\": 2024,\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Automatic\",\n  \"price\": 1350000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update car",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars/4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "4"
              ]
            },
            "description": "200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1299000,\n  \"status\": \"sold\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete car",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "4"
              ]
            },
            "description": "200"
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Car not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "999"
              ]
            },
            "description": "404"
          }
        },
        {
          "name": "Invalid id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "abc"
              ]
            },
            "description": "400 (validateId)"
          }
        },
        {
          "name": "Missing required fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Kia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Wrong Content-Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "415 (requireJson)",
            "body": {
              "mode": "raw",
              "raw": "make=Kia",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars"
              ]
            },
            "description": "400 (error handler)",
            "body": {
              "mode": "raw",
              "raw": "{bad json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "unknown"
              ]
            },
            "description": "404 (notFound)"
          }
        },
        {
          "name": "Deliberate server error",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/error",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "error"
              ]
            },
            "description": "500 (global error handler)"
          }
        }
      ]
    }
  ]
}
